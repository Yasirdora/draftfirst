  "collapse": [
    {
      "name": "bold",
      "text": "**world**",
      "at": 8,
      "expected": {
        "text": "world",
        "run": {
          "start": 0,
          "end": 5,
          "styles": [
            "Bold"
          ]
        },
        "removed": [
          {
            "start": 0,
            "end": 2
          },
          {
            "start": 7,
            "end": 9
          }
        ],
        "caret": 5
      }
    },
    {

{
  "propagate": [
    {
      "name": "shift-after-untouched-before",
      "runs": [
        {
          "start": 0,
          "end": 2,
          "styles": [
            "Bold"
          ]
        },
        {
          "start": 6,
          "end": 8,
          "styles": [
            "Bold"
          ]
        }
      ],
      "replace": {
        "start": 3,
        "end": 3
      },
      "insert": 1,
      "textLength": 8,
      "expected": [
        {
          "start": 0,
          "end": 2,
          "styles": [
            "Bold"
          ]
        },
        {
          "start": 7,
          "end": 9,
          "styles": [
            "Bold"
          ]
        }
      ]
    },
